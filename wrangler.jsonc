// Cloudflare Worker serving the built app (dist/) as static assets, with no Worker script.
// CI builds and deploys it from main once the repo variable DEPLOY is "true"; see
// .github/workflows/ci.yml. The address is permanent: saves are stored per origin in the browser.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "ngutracker",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
  // wrangler creates the DNS record and certificate for the custom domain.
  "routes": [{ "pattern": "ngutracker.worksonmybench.dev", "custom_domain": true }],
  // No *.workers.dev or preview URLs: the account subdomain can identify the owner.
  "workers_dev": false,
  "preview_urls": false,
}
